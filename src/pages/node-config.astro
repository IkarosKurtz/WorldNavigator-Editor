---
import Layout from '../layouts/Layout.astro';
import NodeConfigPanel from '../components/NodeConfigPanel.astro';
---

<Layout
  title="WorldNavigator Editor — Node Configuration"
  description="Configure node properties for a WorldNavigator location."
  fullscreen
>
  <body class="bg-[#f9f9ff] text-[#111c2c] h-screen overflow-hidden flex font-body">

    <!-- Main Workspace -->
    <main class="flex-1 relative flex w-full bg-[#f0f3ff] h-full">

      <!-- Background Canvas Dot Pattern -->
      <div
        class="absolute inset-0 z-0 overflow-hidden graph-dots"
        aria-hidden="true"
      >
        <!-- Watermark -->
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 opacity-[0.03] pointer-events-none flex flex-col items-center select-none">
          <span class="material-symbols-outlined text-[120px]">account_tree</span>
          <span class="font-headline text-4xl font-semibold tracking-tight">NODE LIBRARY</span>
        </div>

        <!-- Background node (dimmed) -->
        <div class="absolute top-1/4 left-1/4 transform -translate-x-1/2 -translate-y-1/2 bg-[#f9f9ff] border border-[#74777f] rounded shadow-[0px_2px_4px_rgba(0,0,0,0.05)] p-4 w-48 opacity-40">
          <div class="flex items-center gap-2 mb-2 pb-2 border-b border-[#c4c6cf]">
            <span class="material-symbols-outlined text-[#002046] text-sm">home</span>
            <span class="font-body text-xs font-semibold uppercase tracking-widest text-[#111c2c]">Town Square</span>
          </div>
          <div class="font-code text-xs text-[#44474e]">ID: loc_001</div>
        </div>

        <!-- Large selected node (circle) -->
        <div
          class="absolute top-1/2 left-[55%] transform -translate-x-1/2 -translate-y-1/2 bg-[#f9f9ff] border-4 border-[#002046] rounded-full shadow-[0px_16px_32px_rgba(0,0,0,0.15)] z-10 flex flex-col items-center justify-center relative overflow-hidden"
          style="width: 40rem; height: 40rem;"
        >
          <!-- Node header: icon + name -->
          <div class="absolute top-16 left-0 w-full flex flex-col items-center justify-center">
            <div class="flex items-center gap-3 mb-2">
              <span class="material-symbols-outlined text-[#002046] text-3xl">storefront</span>
              <span class="font-headline text-3xl font-semibold text-[#111c2c]">Tavern Interior</span>
            </div>
            <div class="font-code text-sm text-[#44474e] bg-[#d8e3fa] px-3 py-1 rounded-full">ID: loc_002</div>
          </div>

          <!-- Description -->
          <div class="px-24 text-center mt-12">
            <p class="font-body text-lg text-[#44474e] leading-relaxed">
              The main gathering area of the local tavern. Smells like stale ale and woodsmoke.
            </p>
          </div>

          <!-- Connection Dots -->
          <div class="absolute top-1/2 -left-4 transform -translate-y-1/2 w-8 h-8 bg-[#002046] border-4 border-[#f9f9ff] rounded-full shadow-md z-20"></div>
          <div class="absolute top-1/2 -right-4 transform -translate-y-1/2 w-8 h-8 bg-[#f9f9ff] border-4 border-[#c4c6cf] rounded-full shadow-inner z-20"></div>
        </div>

        <!-- SVG dashed connection line -->
        <svg class="absolute inset-0 pointer-events-none opacity-40" width="100%" height="100%">
          <path
            d="M 240 250 C 400 250, 400 500, 500 500"
            fill="none"
            stroke="#74777f"
            stroke-width="2"
            stroke-dasharray="4 4"
          />
        </svg>
      </div>

      <!-- Floating Config Panel -->
      <NodeConfigPanel nodeName="Tavern Interior" nodeId="loc_002" />

      <!-- Floating Export Button -->
      <button class="absolute bottom-8 right-8 flex items-center gap-2 px-6 py-3 border border-[#1b365d] bg-[#f9f9ff] text-[#1b365d] rounded-full shadow-[0px_4px_8px_rgba(0,0,0,0.1)] hover:bg-[#d8e3fa] hover:shadow-[0px_6px_12px_rgba(0,0,0,0.15)] active:translate-y-px transition-all z-30">
        <span class="material-symbols-outlined text-xl">download</span>
        <span class="font-body text-xs font-semibold uppercase tracking-widest">Export Project</span>
      </button>

    </main>

  </body>
</Layout>
